# Created by: npx @grok/agent-sdk slack create --dir . --name "점심맛집" --channel-posts
# Do not commit real tokens.

# Lunch Slack channel to collect from (channel details -> bottom "C..." id).
LUNCH_SPOTS_CHANNEL_ID=C...

LUNCH_SPOTS_SLACK_BOT_TOKEN=xoxb-...
LUNCH_SPOTS_SLACK_APP_TOKEN=xapp-...

# Optional: read channel history with your own user token instead of inviting
# the bot. Needs User Token Scopes channels:history + groups:history.
LUNCH_SPOTS_SLACK_USER_TOKEN=xoxp-...

# Optional: map coordinates and Kakao place links for `npm run catalog:enrich`
# and `npm run catalog:kakao-regions`.
# Kakao Developers -> app -> REST API key (Local API).
KAKAO_REST_API_KEY=

# Cloudflare D1 + Pages (Stage 0+). Same account as AI-MARKET; separate DB lunch-radar.
# Pages project: lunch-radar → https://lunch-radar.pages.dev/
# Local Stage 0 uses lunch-spots/.cache/*.sqlite until these are set.
# GitHub Actions: set CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID as repo secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# Optional: local | cloudflare | auto (default auto)
# LUNCH_RADAR_D1_BACKEND=local
