{
  "name": "lunch-spots",
  "private": true,
  "type": "module",
  "description": "agent project: lunch-spots",
  "scripts": {
    "check": "tsc --noEmit",
    "catalog:structure": "tsx scripts/structure-catalog.ts",
    "catalog:enrich": "tsx --env-file-if-exists=.env.local scripts/enrich-places.ts",
    "catalog:naver-folders": "tsx scripts/import-naver-folders.ts",
    "catalog:external-lists": "tsx --env-file-if-exists=.env.local scripts/import-external-lists.mjs",
    "catalog:sikr-partial": "tsx --env-file-if-exists=.env.local scripts/import-sikr-partial.mjs",
    "catalog:purge-non-food": "tsx scripts/purge-non-food.mjs",
    "catalog:fix-districts": "tsx --env-file-if-exists=.env.local scripts/fix-districts.mjs",
    "catalog:matzido": "tsx --env-file-if-exists=.env.local scripts/import-matzido-csv.mjs",
    "catalog:kakao-regions": "tsx --env-file-if-exists=.env.local scripts/kakao-regions.ts",
